<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Report — {{ plugin_name }} | CheckWP</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet">
  <style>
    * { font-family: 'Ubuntu', sans-serif; }
    code, pre, .mono { font-family: 'JetBrains Mono', monospace; }
    body { background: #f8fafc; color: #1e293b; scroll-behavior: smooth; }
    
    .summary-card { background: white; border-radius: 1rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); }
    .table-header { background: #f1f5f9; border-bottom: 1px solid #e2e8f0; }
    
    /* Code Highlighting */
    pre[class*="language-"] {
      border-radius: 0.5rem !important;
      margin: 0 !important;
      font-size: 0.8rem !important;
      background: #0f172a !important;
    }
    .vuln-highlight {
      background: rgba(220, 38, 38, 0.15) !important;
      display: block;
      margin: 0 -1.5rem;
      padding: 0 1.5rem;
      border-left: 4px solid #ef4444;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
    }

    /* Transitions */
    .finding-row { transition: background-color 0.3s ease; }
    .finding-row:hover { background: #f1f5f9 !important; }
    
    .details-container { 
      transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
    }
    .active .details-container,
    .details-container.active {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    
    .rotate-icon { transition: transform 0.3s ease; }
    .active .rotate-icon { transform: rotate(90deg); }
    
    .ai-cta-active .rounded-2xl { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    
    /* Ensure code blocks look premium */
    pre[class*="language-"] { border: 1px solid rgba(255,255,255,0.05) !important; }
    .mono, code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important; }
    .download-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      border-radius: 0.875rem;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }
    .download-btn:hover { transform: translateY(-1px); }

    @media print { .no-print { display: none !important; } }
  </style>
</head>
<body class="min-h-screen py-10">

  <div class="max-w-5xl mx-auto px-6">
    
    {# ─── HEADER (As per screenshot) ─── #}
    <header class="flex items-center justify-between mb-12">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <h1 class="text-xl font-bold text-slate-900 tracking-tight">CheckWP Security Report</h1>
            <p class="text-sm text-slate-500">Generated by <span class="font-bold">CheckWP</span> v0.0.1-alpha.1</p>
        </div>
      </div>
      <div class="text-right text-[13px] text-slate-500 space-y-0.5">
        <p>{{ scan_date }}</p>
        <p>Mode: <span class="font-bold text-slate-900 capitalize">{{ scan_mode }}</span></p>
      </div>
    </header>

    {# ─── SUMMARY CARD (As per screenshot) ─── #}
    <section class="summary-card overflow-hidden mb-12">
      <div class="p-10 border-b border-slate-100">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
          <div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Plugin Under Review</span>
            <h2 class="text-4xl font-black text-slate-900 tracking-tight">{{ plugin_name }}</h2>
            <p class="text-sm font-bold text-slate-500 mt-2">v{{ plugin_version }}</p>
            <p class="text-sm text-slate-400 mono mt-2">{{ plugin_path }}</p>
          </div>

          {% if report_assets %}
          <div class="flex flex-wrap items-center justify-start lg:justify-end gap-3 no-print">
            <a class="download-btn bg-slate-900 text-white hover:bg-slate-800" href="{{ report_assets.pdf_name }}" download>
              PDF
            </a>
            <a class="download-btn bg-indigo-600 text-white hover:bg-indigo-700" href="{{ report_assets.markdown_name }}" download>
              Markdown
            </a>
            <a class="download-btn bg-white text-slate-700 border-slate-200 hover:bg-slate-50" href="{{ report_assets.html_name }}" download>
              HTML
            </a>
          </div>
          {% endif %}
        </div>
      </div>

      <div class="p-10 flex flex-col md:flex-row items-center gap-12 lg:gap-20">
        {# Grade Ring #}
        <div class="flex flex-col items-center">
          <div class="relative w-36 h-36">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="54" stroke="#f1f5f9" stroke-width="12" fill="none"/>
              <circle cx="60" cy="60" r="54" stroke="{{ grade_color }}" stroke-width="12" fill="none"
                      stroke-dasharray="339.29" stroke-dashoffset="{{ 339.29 * (1 - (critical_count * 0.2 + high_count * 0.1 + 0.01) | clamp(0, 1)) }}" stroke-linecap="round"/>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-5xl font-bold" style="color: {{ grade_color }}">{{ grade }}</span>
            </div>
          </div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-4 mb-2">Security Grade</span>
          <div class="text-center max-w-[220px]">
             {% if grade == 'A' %}
               <p class="text-[11px] text-slate-500 leading-relaxed">Excellent. The plugin appears secure. No immediate action is required.</p>
             {% elif grade in ['B', 'C'] %}
               <p class="text-[11px] text-slate-500 leading-relaxed">Moderate risk. Review the findings and consider notifying the plugin developer for an update.</p>
             {% elif grade == 'D' %}
               <p class="text-[11px] text-orange-600 font-medium leading-relaxed">High risk! Consider deactivating this plugin until the developer patches the identified security holes.</p>
             {% else %}
               <p class="text-[11px] text-red-600 font-bold leading-relaxed">Critical risk! Immediately deactivate and remove this plugin. It is unsafe for production use.</p>
             {% endif %}
          </div>
        </div>

        {# Masthead Right Data #}
        <div class="flex-1 flex flex-col justify-center pl-4 lg:pl-12 border-l border-slate-100 space-y-8">
          <div class="flex items-center gap-12">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Scan Mode</span>
              <span class="text-sm font-bold text-slate-700 capitalize">{{ scan_mode }}</span>
            </div>
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Signatures</span>
              <span class="text-sm font-bold text-slate-700">AST + Regex</span>
            </div>
          </div>
          
          <div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-4">Severity Breakdown</span>
            <div class="flex flex-wrap items-center gap-3">
              {% for label, count, color in [('Critical', critical_count, 'red'), ('High', high_count, 'orange'), ('Medium', medium_count, 'amber'), ('Low', low_count, 'blue')] %}
              <div class="px-4 py-2 rounded-xl border border-{{ color }}-100 bg-{{ color }}-50/50 flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-{{ color }}-500"></span>
                <span class="text-sm font-bold text-{{ color }}-700">{{ count }} <span class="hidden sm:inline">{{ label }}</span></span>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      {# Footer Stats #}
      <div class="bg-slate-50/50 px-10 py-5 border-t border-slate-100 flex flex-wrap gap-8 text-[11px] text-slate-500 font-medium">
        <span><strong class="text-slate-800">{{ files_scanned }}</strong> files scanned</span>
        <span><strong class="text-slate-800">{{ total_lines | comma }}</strong> lines analyzed</span>
        <span><strong class="text-slate-800">{{ scan_duration }}s</strong> scan duration</span>
        <span><strong class="text-slate-800">{{ total_findings }}</strong> findings</span>
      </div>
    </section>

    {% if ai_enabled %}
    {# AI Active Dashboard #}
    <div class="mb-12 bg-emerald-500 rounded-2xl p-8 text-white flex flex-col md:flex-row items-center justify-between shadow-xl shadow-emerald-100">
        <div class="flex items-center gap-6 mb-6 md:mb-0">
          <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center shrink-0">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-xl">AI Analysis Active</h3>
            <p class="text-emerald-100 text-sm opacity-90">Deep verification enabled. False positives have been automatically filtered.</p>
          </div>
        </div>
        <div class="flex items-center gap-8">
           <div class="text-right">
              <span class="block text-[10px] font-bold text-emerald-200 uppercase tracking-widest mb-1">Model</span>
              <span class="text-xs font-bold text-white font-mono">{{ ai_model }}</span>
           </div>
           <div class="text-right">
              <span class="block text-[10px] font-bold text-emerald-200 uppercase tracking-widest mb-1">Context Processed</span>
              <span class="text-xs font-bold text-white font-mono">~{{ ai_tokens | comma }} tokens</span>
           </div>
        </div>
    </div>
    {% else %}
    {# AI CTA (New Integration) #}
    <div class="mb-12" id="ai-cta-container">
      <div class="bg-indigo-600 rounded-2xl p-8 text-white flex items-center justify-between cursor-pointer hover:bg-indigo-700 transition-all duration-300 relative z-10" 
           id="ai-cta-header"
           onclick="toggleAI()">
        <div class="flex items-center gap-6">
          <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-xl">Enable AI-Powered Deep Verification</h3>
            <p class="text-indigo-100 text-sm opacity-90">Eliminate false positives and get expert remediation logic automatically.</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <code class="hidden md:block bg-indigo-900/40 px-4 py-2 rounded-lg text-[11px] font-mono text-indigo-200 border border-indigo-400/20">--ai-key sk-...</code>
           <svg class="w-6 h-6 rotate-icon text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
        </div>
      </div>
      
      <div id="ai-info" class="details-container">
         <div class="overflow-hidden">
           <div class="bg-slate-900 rounded-b-2xl p-8 pt-10 text-slate-300 border-x border-b border-slate-800 relative">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                 <div class="space-y-4">
                    <h4 class="text-indigo-400 font-bold uppercase text-[10px] tracking-widest">How to implement</h4>
                   <p class="text-[13px] leading-relaxed">Provide an OpenAI-compatible AI key via command line or environment variable. <strong>CheckWP</strong> will send relevant code blocks to the LLM for deep reasoning and false-positive elimination.</p>
                 </div>
                 <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 shadow-inner">
                    <div class="space-y-4 font-mono text-[11px] leading-relaxed">
                       <div>
                         <span class="text-slate-500 italic block mb-1">// Via command line</span>
                         <code class="block text-indigo-300 font-mono">checkwp ./plugin --ai-key sk-xxxx --ai-endpoint https://api.deepseek.com/v1 --ai-model deepseek-chat</code>
                       </div>
                       <div>
                         <span class="text-slate-500 italic block mb-1">// Via environment variable</span>
                         <code class="block text-emerald-400 font-mono">export CHECKWP_AI_KEY=sk-xxxx</code>
                         <code class="block text-indigo-300 font-mono">checkwp ./plugin --ai-key sk-xxxx --ai-model deepseek-chat</code>
                       </div>
                    </div>
                 </div>
              </div>
           </div>
         </div>
      </div>
    </div>
    {% endif %}

    {# ─── FINDINGS (Card Layout) ─── #}
    <section class="mb-16">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-black text-slate-900 tracking-tight">Vulnerability Findings</h3>
        <span class="text-slate-400 text-xs font-medium">Sorted by severity (most severe first)</span>
      </div>

      <div class="space-y-4">
        {% for f in active_findings %}
        <details class="summary-card overflow-hidden group">
          <summary class="list-none cursor-pointer px-6 py-5 flex flex-wrap items-center gap-4 hover:bg-slate-50 transition-colors">
            <span class="w-8 text-center text-slate-300 font-mono text-[11px]">{{ loop.index }}</span>
            <span class="px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider
              {% if f.severity_value == 5 %}bg-red-100 text-red-600
              {% elif f.severity_value == 4 %}bg-orange-100 text-orange-600
              {% elif f.severity_value == 3 %}bg-amber-100 text-amber-600
              {% elif f.severity_value == 2 %}bg-blue-100 text-blue-600
              {% else %}bg-slate-100 text-slate-500{% endif %}">
              {{ f.severity_label }}
            </span>
            <span class="font-bold text-slate-800 flex-1 min-w-[240px]">{{ f.title }}</span>
            <span class="text-slate-400 font-mono text-[11px] truncate max-w-xs">{{ f.file_path }}</span>
            <span class="text-slate-500 font-mono text-[11px]">{{ f.line_number }}:{{ f.match_column }}</span>
            <svg class="w-4 h-4 rotate-icon text-slate-300 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
          </summary>

          <div class="px-6 py-8 border-t border-slate-100 space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
              <div class="lg:col-span-2 space-y-6">
                <div>
                  <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Technical Description</h4>
                  <p class="text-sm text-slate-600 leading-relaxed">{{ f.description | inline_code | safe }}</p>
                </div>
                <div>
                  <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Source Code Context</h4>
                  <div class="rounded-xl overflow-hidden shadow-lg border border-slate-200">
                    <pre class="line-numbers language-{{ f.language }}"><code class="language-{{ f.language }}">{% for cl in f.context_before %}{{ cl }}
{% endfor %}<span class="vuln-highlight">{{ f.line_content }}</span>{% for cl in f.context_after %}
{{ cl }}{% endfor %}</code></pre>
                  </div>
                </div>
              </div>
              <div class="space-y-4">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                  <h4 class="text-xs font-bold text-red-500 uppercase tracking-widest mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    Security Impact
                  </h4>
                  <p class="text-slate-600 text-[13px] leading-relaxed">{{ f.impact | inline_code | safe }}</p>
                </div>
                <div class="bg-white px-4 py-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">CWE Reference</span>
                  <a href="https://cwe.mitre.org/data/definitions/{{ f.cwe_num }}.html" target="_blank" class="text-xs font-bold text-indigo-600 hover:underline mono">{{ f.cwe }}</a>
                </div>
                <div class="bg-white px-4 py-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Detection Confidence</span>
                  <span class="text-xs font-bold text-slate-700 capitalize">{{ f.confidence }}</span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div class="bg-white border border-slate-200 p-8 rounded-2xl flex flex-col justify-between">
                <div>
                  <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4">For Site Owners (Downloaded Plugins)</h4>
                  {% if f.layman_fix %}
                  <p class="text-[13px] text-slate-700 leading-relaxed mb-6">{{ f.layman_fix | inline_code | safe }}</p>
                  {% else %}
                  <div class="bg-slate-50 border-l-2 border-red-400 p-4 rounded-r-xl mb-6">
                    <p class="text-[13px] text-slate-600 leading-relaxed italic">
                      There is no simple configuration fix for this vulnerability. As a site owner, you cannot safely patch this code directly. We strongly recommend <strong class="text-red-500 font-semibold">deactivating and removing</strong> this plugin immediately. Contact the plugin developer for a security update and do not re-enable it until an official patch is released.
                    </p>
                  </div>
                  {% endif %}
                </div>

                {% if f.ai_analysis %}
                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 mt-auto">
                  <div class="flex items-center gap-2 mb-3">
                    <div class="w-2 h-2 rounded-full {% if f.ai_confirmed %}bg-red-400{% else %}bg-emerald-400{% endif %} animate-pulse"></div>
                    <span class="text-[10px] font-bold text-slate-600 uppercase tracking-widest">AI Audit Verdict</span>
                  </div>
                  <p class="text-[13px] text-slate-800 leading-relaxed font-sans">{{ f.ai_analysis }}</p>
                </div>
                {% endif %}
              </div>

              <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4">For Developers (How to Fix)</h4>
                <p class="text-[13px] text-indigo-100 leading-relaxed mb-6">{{ f.recommendation | inline_code | safe }}</p>

                {% if f.step_by_step_fix %}
                <div class="flex flex-wrap items-center gap-3">
                  {% for step in f.step_by_step_fix %}
                  <div class="flex items-center gap-2 group">
                    <span class="w-5 h-5 rounded-full bg-indigo-500/20 text-indigo-200 border border-indigo-500/30 flex items-center justify-center shrink-0 text-[9px] font-bold">
                      {{ loop.index }}
                    </span>
                    <span class="text-[11px] text-indigo-100 whitespace-nowrap">{{ step | inline_code | safe }}</span>
                    {% if not loop.last %}
                    <svg class="w-3 h-3 text-indigo-400/50 mx-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {% endif %}
                  </div>
                  {% endfor %}
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </details>
        {% endfor %}
      </div>
    </section>

    {# ─── CHECKLIST ─── #}
    <section class="mb-16">
      <div class="bg-slate-900 rounded-3xl p-10 text-white shadow-2xl">
        <div class="flex flex-col md:flex-row items-center gap-10">
          <div class="md:w-1/2 space-y-6">
            <h2 class="text-4xl font-black tracking-tight leading-tight">Security Hardening <br/><span class="text-indigo-400">Action Plan</span></h2>
            <p class="text-slate-400 text-sm leading-relaxed">Ensure your plugin follows these critical security standards before releasing it to production.</p>
          </div>
          <div class="md:w-1/2 bg-white/5 p-8 rounded-2xl border border-white/10 space-y-4 w-full">
             {% set checklist = [
                  "Remove all 'eval()' or 'system()' calls from the code.",
                  "Prepare all database queries using '$wpdb->prepare()'.",
                  "Sanitize all user inputs ($_GET, $_POST) upon arrival.",
                  "Escape all frontend outputs with WordPress esc_* functions.",
                  "Implement capability checks (current_user_can) for all actions.",
                  "Add nonces to all form submissions and AJAX requests."
             ] %}
             {% for item in checklist %}
             <label class="flex items-center gap-4 cursor-pointer group">
                <input type="checkbox" class="w-5 h-5 rounded border-slate-700 bg-slate-800 checked:bg-indigo-500 transition-all cursor-pointer">
                <span class="text-xs text-slate-300 group-hover:text-white transition-colors">{{ item }}</span>
             </label>
             {% endfor %}
          </div>
        </div>
      </div>
    </section>

    {# ─── FILE INVENTORY ─── #}
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold text-slate-800">Scanned File Inventory</h3>
        <span class="text-slate-400 text-xs">{{ files_scanned }} files total</span>
      </div>
      <div class="summary-card overflow-hidden">
        <table class="w-full text-left text-xs">
          <thead class="table-header text-[9px] font-bold text-slate-500 uppercase tracking-widest">
            <tr>
              <th class="py-4 px-6">File Path</th>
              <th class="py-4 px-6 text-center">Engine</th>
              <th class="py-4 px-6 text-center">Lines</th>
              <th class="py-4 px-6 text-center">Entropy</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for fi in file_list %}
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="py-3 px-6 font-mono text-[11px] text-slate-600">{{ fi.relative_path }}</td>
              <td class="py-3 px-6 text-center">
                 <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-500 font-bold uppercase text-[9px]">{{ fi.language }}</span>
              </td>
              <td class="py-3 px-6 text-center text-slate-500">{{ fi.lines }}</td>
              <td class="py-3 px-6 text-center mono {% if fi.entropy > 5.5 %}text-red-500 font-bold{% else %}text-slate-400{% endif %}">
                {{ "%.2f" | format(fi.entropy) }}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

  </div>

  <footer class="mt-20 border-t border-slate-200 pt-10 pb-20 no-print">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-white font-bold text-xs shadow-lg">WPC</div>
        <div>
            <p class="text-xs font-bold text-slate-900">CheckWP v0.0.1-alpha.1</p>
          <p class="text-[10px] text-slate-500 uppercase tracking-widest">Security Audit Engine</p>
          <p class="text-[9px] text-slate-400 mt-1">Created by Kolja Nolte (<a href="mailto:kolja.nolte@gmail.com" class="hover:text-indigo-500 transition-colors">kolja.nolte@gmail.com</a>)</p>
        </div>
      </div>
      
      <div class="flex items-center gap-12 text-[11px] text-slate-500">
        <div class="flex flex-col text-center">
          <span class="uppercase tracking-widest text-[9px] text-slate-400 font-bold mb-1">Files Processed</span>
          <span class="font-bold text-slate-800">{{ files_scanned }} files</span>
        </div>
        <div class="flex flex-col text-center">
          <span class="uppercase tracking-widest text-[9px] text-slate-400 font-bold mb-1">Code Analysis</span>
          <span class="font-bold text-slate-800">{{ total_lines | comma }} lines</span>
        </div>
        <div class="flex flex-col text-center">
          <span class="uppercase tracking-widest text-[9px] text-slate-400 font-bold mb-1">Execution</span>
          <span class="font-bold text-slate-800">{{ scan_duration }}s</span>
        </div>
      </div>

      <div class="flex gap-4">
        <a href="#" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-indigo-600 transition-colors">Documentation</a>
        <a href="#" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-indigo-600 transition-colors">Support</a>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-php.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-javascript.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/line-numbers/prism-line-numbers.min.js"></script>
  
  <script>
    function toggleDetails(id) {
      const row = document.getElementById(id);
      const parentRow = row.previousElementSibling;
      
      const isActive = row.classList.contains('active');
      
      if (!isActive) {
        row.classList.add('active');
        parentRow.classList.add('active');
      } else {
        row.classList.remove('active');
        parentRow.classList.remove('active');
      }
    }
    
    function toggleAI() {
      const container = document.getElementById('ai-cta-container');
      const header = document.getElementById('ai-cta-header');
      
      container.classList.toggle('ai-cta-active');
      container.classList.toggle('active');
    }
  </script>
</body>
</html>
